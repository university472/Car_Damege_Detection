# # Copy trained weights into the models/ directory (see models/README.md).
# PARTS_WEIGHTS=models/car_parts.pt
# DAMAGE_WEIGHTS=models/car_damage.pt
# OUTPUT_DIR=data/artifacts
# UPLOAD_DIR=data/uploads
# DEVICE=auto
# SAMPLE_FPS=2.0
# IMAGE_SIZE=640
# PARTS_CONF=0.25
# DAMAGE_CONF=0.10
# PARTS_IOU=0.60
# DAMAGE_IOU=0.50
# MIN_DAMAGE_COVERAGE=0.25
# AMBIGUITY_MARGIN=0.10
# PART_TRACK_IOU=0.10
# DAMAGE_TRACK_IOU=0.10
# MAX_TRACK_GAP=2
# MIN_REPEAT_OBSERVATIONS=2
# REVIEW_CONFIDENCE=0.25
# MAX_UPLOAD_MB=500
# MAX_DAMAGE_PART_COVERAGE_AUTO_CONFIRM=0.70
# # Local React/Vite frontend origins. Comma-separate origins if hosting elsewhere.
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173


# Copy trained weights into the models/ directory.
PARTS_WEIGHTS=models/car_parts.pt
DAMAGE_WEIGHTS=models/car_damage.pt
OUTPUT_DIR=data/artifacts
UPLOAD_DIR=data/uploads
DEVICE=auto
SAMPLE_FPS=2.0
IMAGE_SIZE=640
PARTS_CONF=0.25
DAMAGE_CONF=0.10
PARTS_IOU=0.60
DAMAGE_IOU=0.50

# Hybrid damage detection
FULL_FRAME_DAMAGE_CONF=0.20
HYBRID_MERGE_MASK_IOU=0.50

# ByteTrack (measured in SAMPLED frames at SAMPLE_FPS)
BYTETRACK_CONFIG=bytetrack.yaml
TRACK_BUFFER=30
BYTETRACK_HIGH_THRESH=0.35
BYTETRACK_LOW_THRESH=0.10
BYTETRACK_NEW_TRACK_THRESH=0.30
BYTETRACK_MATCH_THRESH=0.80

# V2.1 association
MIN_DAMAGE_COVERAGE=0.25
AUTO_MIN_DAMAGE_COVERAGE=0.40
MIN_DAMAGE_CONFIDENCE_AUTO=0.25
MIN_PART_CONFIDENCE_AUTO=0.50
MIN_ASSOCIATION_CONSISTENCY=0.67
DUPLICATE_MASK_IOU=0.90
AMBIGUITY_MARGIN=0.10
MIN_REPEAT_OBSERVATIONS=2
REVIEW_CONFIDENCE=0.25
MAX_DAMAGE_PART_COVERAGE_AUTO_CONFIRM=1.0
MAX_UPLOAD_MB=500

# Legacy thresholds kept so old deployments keep working
PART_TRACK_IOU=0.10
DAMAGE_TRACK_IOU=0.10
MAX_TRACK_GAP=2

# Frontend origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173